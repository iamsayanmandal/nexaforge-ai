# NexaForge Environment Configuration Template
# Duplicate this file to .env and configure your keys.

# Groq Cloud API Key (Required for LangGraph agent and RAG answering)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Identifier
GROQ_MODEL=openai/gpt-oss-20b

# LangSmith Observability & Tracing (Optional, set to true to record traces)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=nexaforge
